generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Storage infrastructure only; the JSON documents retain the original business contracts.
model TripStateDocument {
  tripId    String                 @id
  revision  BigInt
  snapshot  Json                   @db.JsonB
  history   TripStateHistory[]
  proposals TripStateProposal[]
  requests  TripStateIdempotency[]
  memberships TripMembership[]
}

model TripStateHistory {
  tripId         String
  sequence       BigInt
  intentId       String
  changeRecordId String
  intent         Json              @db.JsonB
  change         Json              @db.JsonB
  document       TripStateDocument @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@id([tripId, sequence])
  @@unique([tripId, intentId])
  @@unique([tripId, changeRecordId])
}

model TripStateProposal {
  tripId        String
  proposalId    String
  basisRevision BigInt
  digest        String
  payload       Json              @db.JsonB
  createdAt     DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  expiresAt     DateTime          @db.Timestamptz(6)
  document      TripStateDocument @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@id([tripId, proposalId])
}

model TripStateIdempotency {
  tripId          String
  actorId         String
  operationDomain String
  key             String
  requestDigest   String
  request         Json              @db.JsonB
  response        Json              @db.JsonB
  document        TripStateDocument @relation(fields: [tripId], references: [tripId], onDelete: Restrict)

  @@id([tripId, actorId, operationDomain, key])
}

// Better Auth infrastructure. These are identities and access bindings, not Trip State business objects.
model AuthUser {
  id            String @id
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)
  sessions      AuthSession[]
  accounts      AuthAccount[]
  trips         TripMembership[]
}
model AuthSession {
  id        String @id
  token     String @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model AuthAccount {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}
model AuthVerification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)
  @@index([identifier])
}
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
model TripMembership {
  tripId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  document TripStateDocument @relation(fields: [tripId], references: [tripId], onDelete: Restrict)
  @@id([tripId, userId])
}
