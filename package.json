{
  "name": "antu-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts next.config.ts prisma.config.ts vitest.config.ts eslint.config.mjs --max-warnings 0",
    "test": "vitest run && npm run test:prototype",
    "test:prototype": "node --test tests/prototype-records.test.mjs",
    "dev:prototype": "python3 scripts/serve-prototype.py",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "specs:verify": "node scripts/specs.mjs verify",
    "specs:ac8": "node scripts/verify-ts-ac8-source.mjs",
    "contracts:generate": "node scripts/trip-state-contracts.mjs",
    "contracts:check": "node scripts/trip-state-contracts.mjs --check",
    "check": "npm run project:check && npm run specs:verify && npm run specs:ac8 && npm run contracts:check && npm run dc:check && npm run db:validate && npm run db:generate && npm run typecheck && npm run lint && npm test && npm run build",
    "auth:admin": "tsx scripts/auth-admin.ts",
    "auth:grant-runtime": "node scripts/grant-identity-runtime.mjs",
    "test:http": "node --import tsx --test tests/http/http.e2e.ts",
    "dc:generate": "node scripts/dc-contracts.mjs",
    "dc:check": "node scripts/dc-contracts.mjs --check",
    "test:dc-reference": "python3 scripts/e03-01-reference.py",
    "project:check": "node scripts/check-project-layout.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.14",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.14",
    "dotenv": "^17.2.3",
    "jose": "6.2.13",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "json-schema-to-typescript": "16.0.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
