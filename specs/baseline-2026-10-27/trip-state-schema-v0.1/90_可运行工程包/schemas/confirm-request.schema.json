{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-state.example/spec/0.1/confirm-request.schema.json",
  "title": "confirm-request",
  "type": "object",
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "非空文本"
    },
    "proposal_digest": {
      "type": "string",
      "minLength": 1,
      "description": "非空文本"
    },
    "accept": {
      "type": "boolean"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "proposal_digest",
    "accept"
  ],
  "additionalProperties": false
}
