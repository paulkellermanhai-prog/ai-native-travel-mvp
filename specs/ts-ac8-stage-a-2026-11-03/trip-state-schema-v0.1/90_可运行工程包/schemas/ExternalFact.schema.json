{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-state.example/spec/0.1/ExternalFact.schema.json",
  "title": "ExternalFact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "trip_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "type": {
      "const": "ExternalFact"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "contradicted"
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "trip",
                "entity",
                "skeleton",
                "traveler"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "date"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "minItems": 0,
              "uniqueItems": true,
              "maxItems": 0
            },
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "kind",
            "ids",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "enum": [
            "user",
            "model",
            "system",
            "tool"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "输入或适配器证据标识"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "原始表达或结果摘要"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "actor",
        "actor_id",
        "reference",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "relation": {
            "type": "string",
            "enum": [
              "input",
              "evidence",
              "association"
            ]
          }
        },
        "required": [
          "object_id",
          "version",
          "paths",
          "relation"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "query": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "非空文本"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "date",
        "parameters"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "非空文本"
    },
    "query_status": {
      "type": "string",
      "enum": [
        "result",
        "partial",
        "empty",
        "timeout",
        "error",
        "no_service"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "estimated",
        "date_specific",
        "purchasable"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "current",
        "stale"
      ]
    },
    "applicability": {
      "type": "string",
      "enum": [
        "applicable",
        "unknown",
        "not_applicable"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_for": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "非空文本"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "transport"
              ]
            },
            "from_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "to_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "departure": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "arrival": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_minutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "service_exists": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "from_id",
            "to_id",
            "departure",
            "arrival",
            "duration_minutes",
            "service_exists"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cost"
              ]
            },
            "amount_minor": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "people": {
              "type": "integer",
              "minimum": 1
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "非空文本"
            },
            "item_key": {
              "type": "string",
              "minLength": 1,
              "description": "费用项去重键"
            }
          },
          "required": [
            "kind",
            "amount_minor",
            "currency",
            "people",
            "category",
            "item_key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "condition"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "非空文本"
            }
          },
          "required": [
            "kind",
            "value",
            "description"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "trip_id",
    "type",
    "version",
    "status",
    "scope",
    "source",
    "dependencies",
    "updated_at",
    "subject_ids",
    "query",
    "provider",
    "query_status",
    "verification",
    "freshness",
    "applicability",
    "observed_at",
    "expires_at",
    "valid_for",
    "missing_fields",
    "value"
  ],
  "additionalProperties": false
}
