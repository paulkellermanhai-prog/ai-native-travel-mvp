{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-state.example/spec/0.1/Skeleton.schema.json",
  "title": "Skeleton",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "trip_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "type": {
      "const": "Skeleton"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "archived"
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "trip",
                "entity",
                "skeleton",
                "traveler"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "date"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
              },
              "minItems": 0,
              "uniqueItems": true,
              "maxItems": 0
            },
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "kind",
            "ids",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "enum": [
            "user",
            "model",
            "system",
            "tool"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "输入或适配器证据标识"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "原始表达或结果摘要"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "actor",
        "actor_id",
        "reference",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "relation": {
            "type": "string",
            "enum": [
              "input",
              "evidence",
              "association"
            ]
          }
        },
        "required": [
          "object_id",
          "version",
          "paths",
          "relation"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "scenario",
        "plan"
      ]
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "nights": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entity_id",
          "nights"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "from_id",
          "to_id",
          "fact_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "cost_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "constraint_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "budget"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "intent",
                      "range",
                      "ceiling"
                    ]
                  },
                  "minimum_minor": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maximum_minor": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "people": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "description": "非空文本"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "kind",
                  "mode",
                  "minimum_minor",
                  "maximum_minor",
                  "currency",
                  "people",
                  "categories"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "date_window"
                    ]
                  },
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "duration"
                    ]
                  },
                  "maximum_nights": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "maximum_nights"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "travelers"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "count"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "entry_exit"
                    ]
                  },
                  "entry_entity_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                  },
                  "exit_entity_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                  },
                  "arrival": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "departure": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "entry_entity_id",
                  "exit_entity_id",
                  "arrival",
                  "departure"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "requirement"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "非空文本"
                  },
                  "condition": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "enum": [
                              "always"
                            ]
                          }
                        },
                        "required": [
                          "op"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "enum": [
                              "all",
                              "any"
                            ]
                          },
                          "args": {
                            "type": "array",
                            "items": {
                              "$ref": "https://trip-state.example/spec/0.1/common.schema.json#/$defs/condition"
                            },
                            "minItems": 1
                          }
                        },
                        "required": [
                          "op",
                          "args"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "enum": [
                              "not"
                            ]
                          },
                          "arg": {
                            "$ref": "https://trip-state.example/spec/0.1/common.schema.json#/$defs/condition"
                          }
                        },
                        "required": [
                          "op",
                          "arg"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "ne",
                              "lt",
                              "lte",
                              "gt",
                              "gte"
                            ]
                          },
                          "object_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                          },
                          "path": {
                            "type": "string",
                            "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$"
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "op",
                          "object_id",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "description",
                  "condition"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "constraint_id",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tradeoffs": {
      "type": "object",
      "properties": {
        "gains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "非空文本"
          },
          "minItems": 0
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "非空文本"
          },
          "minItems": 0
        }
      },
      "required": [
        "gains",
        "losses"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unchecked",
            "pending",
            "verified",
            "blocked",
            "stale"
          ]
        },
        "total_nights": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "connection_minutes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 0
        },
        "cost_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1,
                "description": "非空文本"
              },
              "people": {
                "type": "integer",
                "minimum": 1
              },
              "subtotal_minor": {
                "type": "integer",
                "minimum": 0
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "currency",
              "people",
              "subtotal_minor",
              "fact_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "cost_coverage": {
          "type": "string",
          "enum": [
            "partial",
            "none"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "非空文本"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "非空文本"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "total_nights",
        "connection_minutes",
        "cost_groups",
        "cost_coverage",
        "unknowns",
        "violations",
        "checked_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "trip_id",
    "type",
    "version",
    "status",
    "scope",
    "source",
    "dependencies",
    "updated_at",
    "purpose",
    "stops",
    "connections",
    "cost_fact_ids",
    "parent_id",
    "overrides",
    "tradeoffs",
    "assessment"
  ],
  "additionalProperties": false
}
