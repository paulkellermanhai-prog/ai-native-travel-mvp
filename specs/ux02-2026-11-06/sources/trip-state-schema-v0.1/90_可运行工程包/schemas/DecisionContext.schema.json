{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-state.example/spec/0.1/DecisionContext.schema.json",
  "title": "DecisionContext",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "type": {
      "const": "DecisionContext"
    },
    "trip_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "assembled",
        "active",
        "stale",
        "released"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "assembled_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "selected_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "must_include_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "active_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "relevant_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "assembled_from_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "stale_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "type",
    "trip_id",
    "task_id",
    "status",
    "state_revision",
    "assembled_at",
    "expires_at",
    "selected_object_ids",
    "must_include_constraints",
    "active_decisions",
    "open_issues",
    "relevant_facts",
    "assembled_from_versions",
    "stale_fact_ids"
  ],
  "additionalProperties": false
}
