{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-state.example/spec/0.1/OperationIntent.schema.json",
  "title": "OperationIntent",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "type": {
      "const": "OperationIntent"
    },
    "trip_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "user",
        "model",
        "system",
        "tool"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dialogue",
            "map",
            "timeline",
            "tool",
            "system"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "非空文本"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "非空文本"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "reference",
        "text",
        "target_ids"
      ],
      "additionalProperties": false
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "type",
    "trip_id",
    "actor_id",
    "actor_role",
    "input",
    "base_revision",
    "created_at"
  ],
  "additionalProperties": false
}
