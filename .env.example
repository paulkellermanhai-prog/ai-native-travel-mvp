# Local development only. Replace these values for any shared environment.
# Migrations use a separately supplied MIGRATION_DATABASE_URL. Runtime credentials must not own tables.
# Storage integration tests provision disposable identities and keep URLs in a private file outside Git.
DATABASE_URL=postgresql://antu:antu_local_only@127.0.0.1:5432/antu?schema=public
# Only for the migration identity's bounded confirmation-grant deployment utility; never a new/admin role.
# TRIP_STATE_RUNTIME_ROLE=your_existing_non_owner_runtime_role
